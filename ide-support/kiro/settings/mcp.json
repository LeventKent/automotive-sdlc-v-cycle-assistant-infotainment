{
  "mcpServers": {
    "automotive-requirements": {
      "command": "./.venv/bin/python", //path to your local python environment
      "args": [
        "automotive-strands-agents-in-runtime/mcp-servers/automotive-requirements-mcp/requirements-server.py"
      ],
      "env": {
        "AWS_REGION": "us-west-2",
        "FASTMCP_LOG_LEVEL": "INFO",
        "COGNITO_CLIENT_ID": "your_cognito_client_id", // put your own cognito client id from the notebooks here.
        "COGNITO_USERNAME": "your_cognito_user",
        "COGNITO_PASSWORD": "your_cognito_password"
      },
      "disabled": false,
      "autoApprove": [
        "automotive_requirements_analyzer"
      ],
      "disabledTools": []
    },
    "automotive-design": {
      "command": "./.venv/bin/python", //path to your local python environment
      "args": [
        "automotive-strands-agents-in-runtime/mcp-servers/automotive-design-mcp/design-server.py"
      ],
      "env": {
        "AWS_REGION": "us-west-2",
        "FASTMCP_LOG_LEVEL": "INFO",
        "COGNITO_CLIENT_ID": "your_cognito_client_id", // put your own cognito client id from the notebooks here.
        "COGNITO_USERNAME": "your_cognito_user",
        "COGNITO_PASSWORD": "your_cognito_password"
      },
      "disabled": false,
      "autoApprove": [
        "automotive_design_generator"
      ],
      "disabledTools": []
    }
  }
}